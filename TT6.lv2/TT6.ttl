@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<urn:asier:lv2:tt6>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
    doap:name "TT6" ;
    doap:license "GPL-2.0-only" ;
    doap:maintainer [ foaf:name "TTLab" ] ;
    mod:brand "TTLab" ;
    mod:label "TT6" ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;

    lv2:port
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "algo" ; lv2:name "ALGO" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 15 ;
      lv2:scalePoint [ rdfs:label "01_Stack" ; rdf:value 0 ] , [ rdfs:label "02_DoubleStack" ; rdf:value 1 ] , [ rdfs:label "03_Triple2" ; rdf:value 2 ] , [ rdfs:label "04_YStack" ; rdf:value 3 ] , [ rdfs:label "05_Branch" ; rdf:value 4 ] , [ rdfs:label "06_Fan3" ; rdf:value 5 ] , [ rdfs:label "07_Diamond" ; rdf:value 6 ] , [ rdfs:label "08_Pair3" ; rdf:value 7 ] , [ rdfs:label "09_PyramidA" ; rdf:value 8 ] , [ rdfs:label "10_PyramidB" ; rdf:value 9 ] , [ rdfs:label "11_AdditiveAll" ; rdf:value 10 ] , [ rdfs:label "12_OneMod5" ; rdf:value 11 ] , [ rdfs:label "13_TwoMod4" ; rdf:value 12 ] , [ rdfs:label "14_Bell" ; rdf:value 13 ] , [ rdfs:label "15_EPiano" ; rdf:value 14 ] , [ rdfs:label "16_Drone" ; rdf:value 15 ] ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "op1_ratio" ; lv2:name "OP1_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 1.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "op1_level" ; lv2:name "OP1_Level" ; lv2:default 0.80 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "op1_decay" ; lv2:name "OP1_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 1500.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "op2_ratio" ; lv2:name "OP2_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 1.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "op2_level" ; lv2:name "OP2_Level" ; lv2:default 0.50 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "op2_decay" ; lv2:name "OP2_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 1200.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "op3_ratio" ; lv2:name "OP3_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 2.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "op3_level" ; lv2:name "OP3_Level" ; lv2:default 0.45 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "op3_decay" ; lv2:name "OP3_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 900.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "op4_ratio" ; lv2:name "OP4_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 3.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "op4_level" ; lv2:name "OP4_Level" ; lv2:default 0.35 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "op4_decay" ; lv2:name "OP4_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 700.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "op5_ratio" ; lv2:name "OP5_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 5.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "op5_level" ; lv2:name "OP5_Level" ; lv2:default 0.25 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "op5_decay" ; lv2:name "OP5_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 500.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "op6_ratio" ; lv2:name "OP6_Ratio" ; lv2:portProperty pprops:logarithmic ; lv2:default 7.00 ; lv2:minimum 0.25 ; lv2:maximum 32.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "op6_level" ; lv2:name "OP6_Level" ; lv2:default 0.15 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "op6_decay" ; lv2:name "OP6_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 350.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "attack" ; lv2:name "ATTACK" ; lv2:portProperty pprops:logarithmic ; lv2:default 1.00 ; lv2:minimum 0.10 ; lv2:maximum 2000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "sustain" ; lv2:name "SUSTAIN" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "release" ; lv2:name "RELEASE" ; lv2:portProperty pprops:logarithmic ; lv2:default 200.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "feedback" ; lv2:name "FEEDBACK" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "op_mode" ; lv2:name "OP_MODE" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
      lv2:scalePoint [ rdfs:label "FM" ; rdf:value 0 ] , [ rdfs:label "RingMod" ; rdf:value 1 ] , [ rdfs:label "WaveFold" ; rdf:value 2 ] ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "filter_cutoff" ; lv2:name "FILTER_Cutoff" ; lv2:portProperty pprops:logarithmic ; lv2:default 18000.00 ; lv2:minimum 20.00 ; lv2:maximum 20000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "filter_res" ; lv2:name "FILTER_Res" ; lv2:default 0.10 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "lfo_rate" ; lv2:name "LFO_Rate" ; lv2:portProperty pprops:logarithmic ; lv2:default 4.00 ; lv2:minimum 0.05 ; lv2:maximum 30.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "lfo_depth" ; lv2:name "LFO_Depth" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "drive" ; lv2:name "DRIVE" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "gain" ; lv2:name "GAIN" ; lv2:default -6.00 ; lv2:minimum -24.00 ; lv2:maximum 12.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 33 ; lv2:symbol "vel_amount" ; lv2:name "VEL_AMOUNT" ; lv2:default 0.70 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] .
